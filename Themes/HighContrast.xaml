<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AppTitleBarBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AppControlBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppControlHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppControlPressedBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppSubtleFocusBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppSelectionTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AppSelectionIconBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AppMeterTrackBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AppListBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppIconBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
