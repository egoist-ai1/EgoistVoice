<Window x:Class="Egoist.Voice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Egoist.Voice.Controls"
        Title="Egoist Voice"
        Width="344" Height="88"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Focusable="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <CubicEase x:Key="DirectEase" EasingMode="EaseOut" />

        <!--
            Fluent motion uses opposite curves for the two directions: something arriving
            decelerates into place, something leaving accelerates away. The exit animation
            previously had no easing at all, which is why dismissal read as a cut rather than
            a movement.
        -->
        <KeySpline x:Key="DecelerateSpline">0.1,0.9 0.2,1.0</KeySpline>
        <KeySpline x:Key="AccelerateSpline">0.7,0.0 1.0,0.5</KeySpline>
        <KeySpline x:Key="MorphSpline">0.22,1.0 0.36,1.0</KeySpline>

        <!-- Variable speed, not linear: a constant sweep reads as a mechanism, an accelerating and
             decelerating one reads as effort. Same trick every system progress ring uses. -->
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SpinnerOrbitRotate"
                                           Storyboard.TargetProperty="Angle">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="200" KeySpline="0.4,0.0 0.2,1.0" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="360" KeySpline="0.4,0.0 0.2,1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="ListenPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StateHalo" Storyboard.TargetProperty="Opacity"
                             From="0.05" To="0.24" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StateHaloScale" Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1.07" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StateHaloScale" Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1.07" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DownloadStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DownloadArrowOffset" Storyboard.TargetProperty="Y"
                             From="-0.8" To="0.8" Duration="0:0:0.62">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DownloadIcon" Storyboard.TargetProperty="Opacity"
                             From="0.68" To="1" Duration="0:0:0.62" />
        </Storyboard>

        <Storyboard x:Key="SuccessStoryboard">
            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX"
                             From="0.64" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY"
                             From="0.64" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SuccessFlash" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0" Duration="0:0:0.28" />
        </Storyboard>

        <!--
            The shake moves the whole capsule. It used to move only the 28×28 status disc, where
            an amplitude of 2.5 px was small enough that the gesture went unnoticed — an error
            animation nobody sees is an error nobody notices.
        -->
        <Storyboard x:Key="ErrorStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellTranslate" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                <EasingDoubleKeyFrame Value="-4" KeyTime="0:0:0.05" />
                <EasingDoubleKeyFrame Value="4" KeyTime="0:0:0.11" />
                <EasingDoubleKeyFrame Value="-2" KeyTime="0:0:0.17" />
                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:0.24" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--
            The entrance scale used to be 0.972/0.95, a difference small enough that the animation
            was effectively an opacity fade. 0.92 makes the movement readable without turning it
            into a bounce.
        -->
        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.92" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1" KeySpline="{StaticResource DecelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.92" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1" KeySpline="{StaticResource DecelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellTranslate" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="8" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0" KeySpline="{StaticResource DecelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="CapsuleShell" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="ShadowSurface" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22" />
        </Storyboard>

        <Storyboard x:Key="ExitStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="0.94" KeySpline="{StaticResource AccelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="0.94" KeySpline="{StaticResource AccelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellTranslate" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="6" KeySpline="{StaticResource AccelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="CapsuleShell" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.13" />
            <DoubleAnimation Storyboard.TargetName="ShadowSurface" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.13" />
        </Storyboard>

        <!-- Иконка гаснет и проявляется вместе с центральной зоной, а не подменяется мгновенно:
             без этого смена состояния читается как рывок, каким бы плавным ни был морфинг ширины. -->
        <Storyboard x:Key="StateTransitionStoryboard">
            <DoubleAnimation Storyboard.TargetName="CenterContent" Storyboard.TargetProperty="Opacity"
                             From="0.32" To="1" Duration="0:0:0.16"
                             EasingFunction="{StaticResource DirectEase}" />
            <DoubleAnimation Storyboard.TargetName="StateContentTranslate" Storyboard.TargetProperty="X"
                             From="2.5" To="0" Duration="0:0:0.18"
                             EasingFunction="{StaticResource DirectEase}" />
            <DoubleAnimation Storyboard.TargetName="StateDisc" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.20"
                             EasingFunction="{StaticResource DirectEase}" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StateDiscScale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.86" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.20" Value="1" KeySpline="{StaticResource DecelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StateDiscScale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.86" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.20" Value="1" KeySpline="{StaticResource DecelerateSpline}" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!--
            The HWND is a fixed 344×88 and never resizes. Width used to be animated on the window
            itself, which meant a SetWindowPos and a full layout pass on every frame of every state
            change — the single most expensive thing the capsule did, and the reason the chrome
            cache could never hit. CapsuleBody carries the width now; the window merely contains it.
            The gutter around the body is what the drop shadow blurs into.
        -->
        <Grid x:Name="CapsuleBody" Width="218" Height="48"
              HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- A real blurred shadow. The previous three concentric hairlines had no blur at all
                 and read as nested rings against a light background. -->
            <Border x:Name="ShadowSurface" CornerRadius="24" Background="#0A0A0C"
                    IsHitTestVisible="False" Opacity="1" CacheMode="BitmapCache">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                      Color="#000000" Opacity="0.55" />
                </Border.Effect>
            </Border>

            <!--
                A polite live region. The window is deliberately non-focusable, so a screen reader
                can never navigate to it; announcing state changes from here is the only way the
                capsule can say anything at all.
            -->
            <Grid x:Name="CapsuleShell" Opacity="1" RenderTransformOrigin="0.5,0.5"
                  AutomationProperties.Name="Egoist Voice"
                  AutomationProperties.LiveSetting="Polite">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ShellTranslate" />
                </TransformGroup>
            </Grid.RenderTransform>

            <controls:PixelPerfectCapsuleBorder x:Name="RootBorder"
                    CornerRadius="24"
                    Background="#08080A" BorderBrush="#2A2A30"
                    PhysicalStroke="1.6" RasterScale="4"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="RootBorder_OnMouseLeftButtonDown"
                    ToolTip="Перетащить">
                <controls:PixelPerfectCapsuleBorder.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.167" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.167" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </controls:PixelPerfectCapsuleBorder.Triggers>

                <Grid Margin="1">
                    <Border x:Name="SurfaceGradient" CornerRadius="23" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0D0D10" Offset="0" />
                                <GradientStop Color="#050506" Offset="0.68" />
                                <GradientStop Color="#020203" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HoverSurface" CornerRadius="23" Background="#10FF2634"
                            Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="SuccessFlash" CornerRadius="23" Background="#20FF2634"
                            Opacity="0" IsHitTestVisible="False" />

                    <Grid>
                        <!-- Разделителей больше нет: расстояние разделяет не хуже, а жёсткая
                             вертикальная черта была последним резким элементом среди
                             растворяющегося контура и волосяной кривой волны. Колонки под них
                             оставлены как отступы. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="TimerColumn" Width="0" />
                            <ColumnDefinition x:Name="ActionDividerColumn" Width="6" />
                            <ColumnDefinition x:Name="ActionColumn" Width="30" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="28" Height="28">
                            <Ellipse x:Name="StateHalo" Fill="#FF2634" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="StateHaloScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Border x:Name="StateDisc" Margin="2" CornerRadius="12" Background="Transparent"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="StateDiscScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="StateShake" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <!--
                                        Векторный микрофон вместо глифа Segoe Fluent. Глиф рисуется
                                        заливкой, а всё остальное на капсуле — контуром: рядом с
                                        волосяной линией волны и тонким контуром пилюли залитая
                                        иконка выглядела инородной. Здесь та же толщина линии и те
                                        же скруглённые окончания.
                                    -->
                                    <Canvas x:Name="MicIcon" Width="18" Height="18"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Stroke="#FFFFFF" StrokeThickness="1.35"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Opacity="0.94"
                                              Data="M 6.3,5.6 A 2.7,2.7 0 0 1 11.7,5.6 L 11.7,8.3 A 2.7,2.7 0 0 1 6.3,8.3 Z
                                                    M 3.7,9.1 A 5.3,5.3 0 0 0 14.3,9.1
                                                    M 9,14.4 L 9,16.1" />
                                    </Canvas>
                                    <!-- Векторная галочка вместо глифа: та же толщина линии и те же
                                         скруглённые окончания, что у микрофона и у гребня волны. -->
                                    <Canvas x:Name="CheckIcon" Visibility="Collapsed" Width="18" Height="18"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform><ScaleTransform x:Name="CheckScale" /></Canvas.RenderTransform>
                                        <Path Stroke="#FFFFFF" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Opacity="0.94"
                                              Data="M 4.2,9.4 L 7.6,12.9 L 13.8,5.6" />
                                    </Canvas>
                                    <TextBlock x:Name="ClipboardIcon" Visibility="Collapsed" Text="&#xE77F;"
                                               FontFamily="Segoe Fluent Icons" Foreground="#F7F7F8" FontSize="14"
                                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- A 270° arc rather than four orbiting dots. The dots read as
                                         a 2014 loading indicator and, being small, barely showed
                                         motion at all; an arc with rounded caps is what every
                                         current system spinner uses. -->
                                    <Grid x:Name="SpinnerIcon" Visibility="Collapsed" Width="18" Height="18">
                                        <Path Stroke="#FF2634" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 9,1.6 A 7.4,7.4 0 1 1 1.6,9"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform x:Name="SpinnerOrbitRotate" /></Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <TextBlock x:Name="DownloadIcon" Visibility="Collapsed" Text="&#xE896;"
                                               FontFamily="Segoe Fluent Icons" Foreground="#FF2634" FontSize="15"
                                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="DownloadArrowOffset" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <!-- Восклицательный знак в круге, нарисованный линией. Форма
                                         намеренно отличается от галочки: цвет — не единственный
                                         признак, по которому отказ отличается от успеха. -->
                                    <Canvas x:Name="ErrorIcon" Visibility="Collapsed" Width="18" Height="18"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Stroke="#F59E0B" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 9,2.2 A 6.8,6.8 0 1 1 8.99,2.2 Z
                                                    M 9,5.6 L 9,10.1
                                                    M 9,12.9 L 9,13.0" />
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>


                        <Grid x:Name="CenterContent" Grid.Column="2" Margin="9,0"
                              VerticalAlignment="Center" Height="24" Opacity="1">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="StateContentTranslate" />
                            </Grid.RenderTransform>
                            <!-- Растянута, а не отцентрована: кривая занимает всю доступную ширину,
                                 а поля разводят её с микрофоном слева и с таймером справа, чтобы
                                 цифры никогда не ложились поверх волны. -->
                            <controls:CapsuleWaveform x:Name="Waveform"
                                                      VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                      Margin="2,0,12,0"
                                                      AutomationProperties.Name="Индикатор уровня звука" />

                            <Grid x:Name="ProcessingDots" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ProcessingLabel" Text="Распознаю" Foreground="#F7F7F8"
                                           FontSize="12.5" FontWeight="SemiBold" />
                            </Grid>

                            <TextBlock x:Name="DetailText" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#F7F7F8" FontSize="12.5" FontWeight="SemiBold" />
                            <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Height="2"
                                         Margin="0,0,0,1" VerticalAlignment="Bottom" Minimum="0" Maximum="100"
                                         Background="#25252A" Foreground="#FF2634" BorderThickness="0" />
                        </Grid>

                        <!-- Tabular figures: proportional digits make the seconds column jitter
                             on every tick, which reads as the whole capsule twitching. -->
                        <TextBlock x:Name="RecordingTimer" Grid.Column="3" Visibility="Collapsed"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                   Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Opacity="0.82"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.Name="Длительность записи" />


                        <Button x:Name="CloseButton" Grid.Column="5" Click="CloseButton_OnClick"
                                Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                Foreground="#D0D0D4" Focusable="False" Cursor="Hand" ToolTip="Отменить"
                                AutomationProperties.Name="Отменить диктовку">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" CornerRadius="13" Background="{TemplateBinding Background}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons"
                                                   Foreground="{TemplateBinding Foreground}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#2EFF2634" />
                                            <Setter Property="Foreground" Value="#FF5962" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#4AFF2634" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </controls:PixelPerfectCapsuleBorder>
            </Grid>
        </Grid>
    </Grid>
</Window>
