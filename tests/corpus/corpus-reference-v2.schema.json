{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egoist.local/schemas/voice/corpus-reference-v2.schema.json",
  "title": "Egoist Voice private corpus reference JSONL node",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "privacy", "scriptSha256"],
      "properties": {
        "kind": { "const": "corpus-reference" },
        "schemaVersion": { "const": 2 },
        "privacy": { "const": "private-local-only" },
        "scriptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audio", "text", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{3}$" },
        "audio": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{3}\\.wav$" },
        "text": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "entities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "translationCommand": { "type": "boolean" },
        "boundary": { "enum": ["start", "end"] },
        "boundaryTarget": { "type": "string", "minLength": 1 }
      }
    }
  ]
}

