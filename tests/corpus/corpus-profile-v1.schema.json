{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egoist.local/schemas/voice/corpus-profile-v1.schema.json",
  "title": "Egoist Voice public corpus benchmark profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "buckets"],
  "properties": {
    "schema": { "const": "egoist.voice.corpus-profile/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "buckets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{3}$" }
      }
    }
  }
}
