<Window x:Class="Egoist.Voice.CustomShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Своя кнопка запуска"
        Width="420" Height="224"
        MinWidth="420" MinHeight="224"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        KeyboardNavigation.TabNavigation="Cycle"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextDisabledBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppIconBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSubtleFocusBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource AppTitleBarBrush}"
                  MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <TextBlock Margin="18,0,0,0" VerticalAlignment="Center"
                           Text="Своя кнопка запуска" Foreground="{DynamicResource AppTextPrimaryBrush}"
                           FontFamily="Segoe UI Variable Display" FontSize="13" FontWeight="SemiBold" />
                <Button Width="34" Height="34" Margin="0,0,7,0" HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        FontFamily="Segoe Fluent Icons" FontSize="12" Content="&#xE711;"
                        Cursor="Hand" ToolTip="Закрыть"
                        AutomationProperties.Name="Закрыть диалог"
                        Click="Cancel_OnClick" />
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AppBorderBrush}" />
            </Grid>

            <Grid Grid.Row="1" Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Нажмите клавишу или сочетание"
                           Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12.5" />

                <Border x:Name="CaptureSurface" Grid.Row="1" Margin="0,8,0,0"
                        Style="{StaticResource CaptureSurfaceStyle}"
                        CornerRadius="8" Focusable="True" FocusVisualStyle="{x:Null}"
                        AutomationProperties.Name="Поле записи сочетания клавиш"
                        AutomationProperties.HelpText="Нажмите клавишу или сочетание. Escape отменяет ввод."
                        PreviewKeyDown="CaptureSurface_OnPreviewKeyDown"
                        PreviewKeyUp="CaptureSurface_OnPreviewKeyUp"
                        MouseLeftButtonDown="CaptureSurface_OnMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                   Foreground="{DynamicResource AppSelectionIconBrush}" Margin="14,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShortcutText" Text="Нажмите сочетание…"
                                   Foreground="{DynamicResource AppSelectionTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Text="Esc — отмена"
                               Foreground="{DynamicResource AppTextDisabledBrush}" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DialogButton}" Content="Отмена"
                                AutomationProperties.Name="Отменить выбор сочетания"
                                Margin="0,0,8,0" Click="Cancel_OnClick" />
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryDialogButton}"
                                Content="Сохранить" IsEnabled="False"
                                AutomationProperties.Name="Сохранить сочетание"
                                Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
