<Window x:Class="Egoist.Voice.CustomShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Своя кнопка запуска"
        Width="396" Height="208"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#050505"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#F7F7F8" />
            <Setter Property="Background" Value="#151518" />
            <Setter Property="BorderBrush" Value="#34343A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A0B0F" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#7A1C25" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A0D12" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#707078" />
                                <Setter TargetName="Chrome" Property="Background" Value="#0C0C0E" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#202024" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A2A30" BorderThickness="1" Background="#08080A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#050506" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Text="Своя кнопка запуска" Foreground="#F7F7F8"
                           FontFamily="Segoe UI Variable Display" FontSize="13" FontWeight="SemiBold" />
                <Button Width="32" Height="32" Margin="0,0,7,0" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="#A3A3AA"
                        FontFamily="Segoe Fluent Icons" FontSize="12" Content="&#xE711;"
                        Cursor="Hand" Click="Cancel_OnClick" />
                <Border Height="1" VerticalAlignment="Bottom" Background="#242428" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,13,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Нажмите клавишу или сочетание"
                           Foreground="#A3A3AA" FontFamily="Segoe UI Variable Text" FontSize="12.5" />

                <Border x:Name="CaptureSurface" Grid.Row="1" Margin="0,8,0,0"
                        Background="#020203" BorderBrush="#4A151B" BorderThickness="1"
                        CornerRadius="8" Focusable="True" FocusVisualStyle="{x:Null}"
                        PreviewKeyDown="CaptureSurface_OnPreviewKeyDown"
                        PreviewKeyUp="CaptureSurface_OnPreviewKeyUp"
                        MouseLeftButtonDown="CaptureSurface_OnMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                   Foreground="#FF2634" Margin="13,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShortcutText" Text="Нажмите сочетание…"
                                   Foreground="#F7F7F8" FontFamily="Segoe UI Variable Text"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Text="Esc — отмена"
                               Foreground="#707078" FontFamily="Segoe UI Variable Text" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DialogButton}" Content="Отмена"
                                Margin="0,0,8,0" Click="Cancel_OnClick" />
                        <Button x:Name="SaveButton" Style="{StaticResource DialogButton}"
                                Content="Сохранить" IsEnabled="False"
                                Background="#FF2634" BorderBrush="#FF4B57"
                                Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
